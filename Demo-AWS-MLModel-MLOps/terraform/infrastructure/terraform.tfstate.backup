    {
      "module": "module.ml-pipeline",
      "mode": "managed",
      "type": "aws_sfn_state_machine",
      "name": "sfn_state_machine",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:states:us-east-1:303467243373:stateMachine:ml-pipeline-terraform-demo-state-machine",
            "creation_date": "2026-06-11T05:29:32Z",
            "definition": "{\n\"Comment\": \"An AWS Step Function State Machine to train, build and deploy an Amazon SageMaker model endpoint\",\n\"StartAt\": \"Configuration Lambda\",\n\"States\": {\n  \"Configuration Lambda\": {\n    \"Type\": \"Task\",\n    \"Resource\": \"arn:aws:lambda:us-east-1:303467243373:function:config-ml-pipeline-terraform-demo\",\n    \"Parameters\": {\n      \"PrefixName\": \"ml-pipeline-terraform-demo\",\n      \"input_training_path\": \"$.input_training_path\"\n      },\n    \"Next\": \"Create Training Job\",\n    \"ResultPath\": \"$.training_job_name\"\n    },\n  \"Create Training Job\": {\n    \"Type\": \"Task\",\n    \"Resource\": \"arn:aws:states:::sagemaker:createTrainingJob.sync\",\n    \"Parameters\": {\n      \"TrainingJobName.$\": \"$.training_job_name\",\n      \"ResourceConfig\": {\n        \"InstanceCount\": 1,\n        \"InstanceType\": \"ml.m5.xlarge\",\n        \"VolumeSizeInGB\": 5\n      },\n      \"HyperParameters\": {\n        \"test\": \"test\"\n      },\n      \"AlgorithmSpecification\": {\n        \"TrainingImage\": \"303467243373.dkr.ecr.us-east-1.amazonaws.com/ml-pipeline-terraform-demo\",\n        \"TrainingInputMode\": \"File\"\n      },\n      \"OutputDataConfig\": {\n        \"S3OutputPath\": \"s3://ml-pipeline-terraform-demo-output-models-303467243373\"\n      },\n      \"StoppingCondition\": {\n        \"MaxRuntimeInSeconds\": 86400\n      },\n      \"RoleArn\": \"arn:aws:iam::303467243373:role/ml-pipeline-terraform-demo-sagemaker-exec\",\n      \"InputDataConfig\": [\n      {\n        \"ChannelName\": \"training\",\n        \"ContentType\": \"text/csv\",\n        \"DataSource\": {\n          \"S3DataSource\": {\n            \"S3DataType\": \"S3Prefix\",\n            \"S3Uri\": \"s3://ml-pipeline-terraform-demo-training-data-303467243373\",\n            \"S3DataDistributionType\": \"FullyReplicated\"\n          }\n        }\n      }\n      ]\n    },\n    \"Next\": \"Create Model\"\n  },\n  \"Create Model\": {\n    \"Parameters\": {\n      \"PrimaryContainer\": {\n        \"Image\": \"303467243373.dkr.ecr.us-east-1.amazonaws.com/ml-pipeline-terraform-demo\",\n        \"Environment\": {},\n        \"ModelDataUrl.$\": \"$.ModelArtifacts.S3ModelArtifacts\"\n      },\n      \"ExecutionRoleArn\": \"arn:aws:iam::303467243373:role/ml-pipeline-terraform-demo-sagemaker-exec\",\n      \"ModelName.$\": \"$.TrainingJobName\"\n    },\n    \"Resource\": \"arn:aws:states:::sagemaker:createModel\",\n    \"Type\": \"Task\",\n    \"ResultPath\":\"$.taskresult\",\n    \"Next\": \"Create Endpoint Config\"\n  },\n  \"Create Endpoint Config\": {\n    \"Type\": \"Task\",\n    \"Resource\": \"arn:aws:states:::sagemaker:createEndpointConfig\",\n    \"Parameters\":{\n      \"EndpointConfigName.$\": \"$.TrainingJobName\",\n      \"ProductionVariants\": [\n      {\n        \"InitialInstanceCount\": 1,\n        \"InstanceType\": \"ml.c5.large\",\n        \"ModelName.$\": \"$.TrainingJobName\",\n        \"VariantName\": \"AllTraffic\"\n      }\n      ]\n    },\n    \"ResultPath\":\"$.taskresult\",\n    \"Next\":\"Create Endpoint\"\n  },\n  \"Create Endpoint\":{\n    \"Type\":\"Task\",\n    \"Resource\":\"arn:aws:states:::sagemaker:createEndpoint\",\n    \"Parameters\":{\n      \"EndpointConfigName.$\": \"$.TrainingJobName\",\n      \"EndpointName.$\": \"$.TrainingJobName\"\n    },\n    \"End\": true\n    }\n  }\n}\n",
            "description": "",
            "encryption_configuration": [
              {
                "kms_data_key_reuse_period_seconds": 0,
